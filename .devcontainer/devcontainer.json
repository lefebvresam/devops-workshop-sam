{
  "name": "Workshop Saleconix",
  "dockerComposeFile": [
    "../compose.yaml",
    "compose.devcontainer.yaml"
  ],
  "service": "workspace",
  "runServices": [
    "frontend",
    "backend",
    "workspace"
  ],
  "workspaceFolder": "/workspaces/workshop",
  "forwardPorts": [8000, 5678],
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose",
  "postCreateCommand": "./scripts/verify-devcontainer.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.debugpy"
      ]
    }
  }
}
